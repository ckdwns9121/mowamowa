{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the tray lists and Pomodoro pet",
  "windows": [
    "tray",
    "pet"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
