{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MowaMowa",
  "version": "0.1.0",
  "identifier": "com.orbit.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "tray",
        "title": "MowaMowa Quick View",
        "width": 360,
        "height": 520,
        "minWidth": 360,
        "minHeight": 520,
        "maxWidth": 360,
        "maxHeight": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": false
      },
      {
        "label": "pet",
        "title": "MowaMowa Pomodoro Pet",
        "width": 240,
        "height": 108,
        "minWidth": 240,
        "minHeight": 108,
        "maxWidth": 240,
        "maxHeight": 108,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:orbit.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
